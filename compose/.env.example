# Dev-only placeholder values for the local compose stack.
#
# Copy this file to compose/.env (gitignored) before `make up`. Every
# value here is a dummy for local containers on your own laptop -- NONE
# of these are real secrets, and none should ever be replaced with real
# ones in this file (see CLAUDE-equivalent working rule in README.md:
# "Don't store passwords anywhere new" applies to the real DBA agent
# project, not to this throwaway compose network, but the habit is the
# same: this file stays fake forever).

# --- agent (src/dba_agent/config.py refuses to start without these) ---
ANTHROPIC_API_KEY=dev-placeholder-anthropic-key-not-real
SLACK_BOT_TOKEN=xoxb-dev-placeholder-not-real

# --- postgres primary ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_only_postgres_pw
POSTGRES_DB=postgres

# --- postgres streaming replication (postgres -> postgres-replica) ---
# Dev-only, hardcoded to match compose/postgres/init/01_replication_role.sql
# (docker-entrypoint-initdb.d SQL scripts aren't env-substituted, so the
# role's password is a literal in that file -- if you change one, change
# both).
REPLICATION_USER=replicator
REPLICATION_PASSWORD=dev_only_replicator_pw

# --- oracle (gvenzl/oracle-free) ---
ORACLE_PASSWORD=DevOnly_Oracle_Pw1

# --- alert injector real-mode (optional) ---
# Only read when `make inject-alert ... SLACK_MODE=real` is used. Leave
# unset for the default fake mode (no Slack workspace needed at all).
# SLACK_TEST_CHANNEL=C0000000000
